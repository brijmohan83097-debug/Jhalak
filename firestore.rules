rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isSuperAdmin() {
      return isSignedIn() && (request.auth.token.email == 'brijmohan83097@gmail.com');
    }

    // Users collection: Public read for creator profiles, reels counters, watch hours
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Posts collection: Public read for all reels and photo posts
    match /posts/{postId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
